function updateToday(mins) {
  if (dd?.today) dd.today.estimated_minutes = mins;
  switchView('overview');
  toast('✅ 今日可用时间已更新为 ' + mins + ' 分钟');
}

document.querySelectorAll('#nav button').forEach(btn => {
  btn.addEventListener('click', () => switchView(btn.dataset.v));
});

